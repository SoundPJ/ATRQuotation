<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <title>ระบบจำลองพรีวิว PDF (Playground)</title>
  <!-- ดึงไลบรารี pdf-lib มาใช้งาน -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js"></script>
  
  <style>
    body { font-family: sans-serif; margin: 0; padding: 20px; background: #f0f2f5; display: flex; flex-direction: column; height: 100vh; box-sizing: border-box; }
    .toolbar { margin-bottom: 15px; display: flex; gap: 10px; align-items: center; }
    .btn { background: #1a56a0; color: white; border: none; padding: 10px 20px; font-weight: bold; border-radius: 5px; cursor: pointer; }
    .btn:hover { background: #0f2d5e; }
    .preview-container { flex: 1; background: white; border: 2px dashed #ccc; border-radius: 8px; overflow: hidden; }
    iframe { width: 100%; height: 100%; border: none; }
  </style>
</head>
<body>

  <div class="toolbar">
    <h3>🛠 หน้าต่างทดสอบจำลอง PDF</h3>
    <!-- ปุ่มสำหรับกดสั่งรันโค้ดและดูผลลัพธ์ -->
    <button class="btn" onclick="runPdfPreview()">⚡️ กดทดสอบพรีวิว</button>
  </div>

  <!-- กล่อง iframe ที่จะทำหน้าที่เป็นหน้าจอจำลองแสดง PDF -->
  <div class="preview-container">
    <iframe id="pdfFrame" src="about:blank"></iframe>
  </div>

  <script>
    // ── ส่วนที่คุณสามารถมาลองแก้โค้ดเพื่อเทสต์ระบบวาด PDF ได้ตรงนี้ ──
    async function runPdfPreview() {
      try {
        const { PDFDocument, rgb } = PDFLib;
        // pdfDoc.registerFontkit(fontkit);
        console.log("Regenerating preview...")
        const NAVY  = rgb(0x0F/255, 0x2D/255, 0x5E/255);
        const BLUE  = rgb(0x1A/255, 0x56/255, 0xA0/255);
        const GRAY  = rgb(0x55/255, 0x55/255, 0x55/255);
        const LINEC = rgb(0xD8/255, 0xDE/255, 0xE6/255);
        const LIGHT = rgb(0xEB/255, 0xF3/255, 0xFF/255);
        const INK   = rgb(0x1F/255, 0x29/255, 0x37/255);
        const WHITE = rgb(1, 1, 1);
        const pdfDoc = await PDFDocument.create();
        const PAGE_W = 595.28; 
        const PAGE_H = 841.89;
        const MARGIN = 40;
        const CONTENT_W = PAGE_W - MARGIN * 2;

        const page = pdfDoc.addPage([PAGE_W, PAGE_H]); 
        let y = PAGE_H - MARGIN - 50;
        const logoX = MARGIN, logoY = y;
        // const pngUrl = 'data/ATRlogo.png';
        // const pngUrl = 'data/AIlogo.png';
        const pngUrl = 'data/SMlogo.png';
        const pngImageBytes = await fetch(pngUrl).then((res) => res.arrayBuffer());
        const pngImage = await pdfDoc.embedPng(pngImageBytes);
        const pngDims = pngImage.scale(0.11);
        page.drawImage(pngImage, {
          x: logoX,
          y: logoY,
          width: pngDims.width,
          height: pngDims.height,
        });  
        let hx = MARGIN + 100;
        const boldfont = await pdfDoc.embedFont(PDFLib.StandardFonts.HelveticaBold);
        const font = await pdfDoc.embedFont(PDFLib.StandardFonts.Helvetica);
        page.drawText('ATIRUJ CO., LTD.', {
          x: hx,
          y: 800,
          size: 14,
          font: boldfont,
          color: NAVY,
        });
        page.drawText( '1486 Moo7, ThepharakRd., Thepharak, Mueang, Samut Prakan 10270', {
          x: hx,
          y: 785,
          size: 10,
          font: font,
          color: NAVY,
        });
        page.drawText( 'TAX ID: 0 1155 38001 69 4	Email: atiruj.co@gmail.com	Line ID: atiruj.co', {
          x: hx,
          y: 770,
          size: 10,
          font: font,
          color: NAVY,
        });
        page.drawText( 'Tel. 0 2759 6861, 0 87689 4080	Fax: 0 2383 7126', {
          x: hx,
          y: 755,
          size: 10,
          font: font,
          color: NAVY,
        });     
        y = y-20;
        

        // ── กลไกแปลงข้อมูลส่งเข้าหน้าจอพรีวิว (ไม่ต้องโหลดลงเครื่อง) ──
        const pdfBytes = await pdfDoc.save();
        const blob = new Blob([pdfBytes], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);
        
        // ล้างหน่วยความจำอันเก่าออกก่อน (ป้องกันเครื่องอืด)
        const iframe = document.getElementById('pdfFrame');
        if (iframe.dataset.oldUrl) {
          URL.revokeObjectURL(iframe.dataset.oldUrl);
        }
        
        // ยิง URL เข้าไปใน iframe เพื่อแสดงผลหน้าจอขวา
        iframe.src = url;
        iframe.dataset.oldUrl = url;

      } catch (error) {
        alert('เกิดข้อผิดพลาดในการรันโค้ด: ' + error.message);
      }
    }

    // สั่งให้รันพรีวิวทันทีที่เปิดหน้าเว็บครั้งแรก
    window.onload = runPdfPreview;
  </script>

</body>
</html>